# Set these in Vercel Project Settings > Environment Variables.
# Keep secrets out of Git and never paste them into public client-side code.
N8N_PUBLIC_JOBS_WEBHOOK=https://YOUR-N8N-HOST/webhook/public-jobs
N8N_ADMIN_DECISION_WEBHOOK=https://YOUR-N8N-HOST/webhook/admin-decision
ADMIN_ACCESS_TOKEN=replace-with-a-long-random-secret
N8N_WEBHOOK_SECRET=another-long-random-secret
